{
  "name": "@message-ui/cli",
  "version": "0.1.0",
  "description": "CLI to preview and export Message UI attachment templates.",
  "license": "MIT",
  "author": "pontusab",
  "homepage": "https://github.com/pontusab/message-ui#readme",
  "repository": {
    "type": "git",
